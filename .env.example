# Pi Network API Key (get from Developer Portal at develop.pi in Pi Browser)
PI_API_KEY=your_pi_api_key_here

# App port
PORT=3000

# Your app's production URL (must be HTTPS)
PRODUCTION_URL=https://your-domain.com

# Set to "development" for sandbox mode, "production" for mainnet
NODE_ENV=development

# Allowed CORS origin (set to your frontend URL in production)
ALLOWED_ORIGIN=*
